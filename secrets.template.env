# Copy this file as secrets.env and customize the values.
# "space" can be found in the Confluence URL.
# Find the Cloud ID through Atlassian's accessible-resources endpoint.

export CONFLUENCE_CLOUD_ID=00000000-0000-0000-0000-000000000000

# scoped Atlassian service-account token
export CONFLUENCE_API_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXX

# part of the URL after "/wiki/spaces/"
export CONFLUENCE_SPACE=MYSPACE
